IMMICH_URL=http://immich-server:2283
IMMICH_API_KEY=replace-me
# Or use IMMICH_API_KEY_FILE=/run/secrets/immich_api_key

# Recommended: use Frigate's internal Docker-network API port when this bridge is
# on the same trusted Compose/network segment.
FRIGATE_URL=http://frigate:5000
# Optional: bearer token for Frigate's authenticated port/reverse proxy.
# FRIGATE_API_KEY=
# Or use FRIGATE_API_KEY_FILE=/run/secrets/frigate_api_key

SYNC_INTERVAL=24h
FACES_PER_PERSON=10
PEOPLE_MODE=favorites
DRY_RUN=true
RUN_ONCE=false
LOG_LEVEL=INFO
DATA_DIR=/data
HEALTH_PORT=8080
